APP_NAME=Career Copilot - Agent Service
APP_ENV=development
APP_VERSION=0.1.0
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8002
LOG_LEVEL=INFO

# Optional AI provider. The service falls back to the deterministic JD-first
# workflow when Gemini is disabled or unavailable.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_ENABLED=false
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=35
GEMINI_RATE_LIMIT_COOLDOWN_SECONDS=60
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_SERVER_RETRIES=1
GEMINI_RETRY_BACKOFF_SECONDS=1

SEMANTIC_STRONG_THRESHOLD=0.85
SEMANTIC_PARTIAL_THRESHOLD=0.70
SCORING_VERSION=phase6-v2
