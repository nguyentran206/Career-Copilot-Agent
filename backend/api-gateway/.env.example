APP_NAME=Career Copilot - API Gateway
APP_ENV=development
APP_VERSION=0.1.0

API_PREFIX=/api/v1

HOST=127.0.0.1
PORT=8000

FRONTEND_URL=http://localhost:3000

DOCUMENT_PARSER_SERVICE_URL=http://127.0.0.1:8001
AGENT_SERVICE_URL=http://127.0.0.1:8002

DOCUMENT_PARSER_TIMEOUT_SECONDS=30
AGENT_SERVICE_TIMEOUT_SECONDS=150
MAX_CV_FILE_SIZE_MB=5
MAX_JD_FILE_SIZE_MB=5
SESSION_TTL_MINUTES=30
MAX_SESSIONS=500
ANALYZE_RATE_LIMIT_REQUESTS=10
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_ANALYSES=3

LOG_LEVEL=INFO
