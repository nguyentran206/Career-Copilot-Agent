APP_ENV=production
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=https://your-project.vercel.app
DOCUMENT_PARSER_SERVICE_URL=http://document-parser-service:8001
AGENT_SERVICE_URL=http://agent-service:8002
DOCUMENT_PARSER_TIMEOUT_SECONDS=30
AGENT_SERVICE_TIMEOUT_SECONDS=150
MAX_CV_FILE_SIZE_MB=5
MAX_JD_FILE_SIZE_MB=5
SESSION_TTL_MINUTES=30
MAX_SESSIONS=500
ANALYZE_RATE_LIMIT_REQUESTS=10
ANALYZE_RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_ANALYSES=3
LOG_LEVEL=INFO
